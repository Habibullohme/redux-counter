# ===== MAJBURIY =====
# @BotFather bergan token
BOT_TOKEN=1234567890:AAAA-bu-yerga-bot-tokeningizni-yozing
# Kanal ID si (-100 bilan boshlanadi) yoki kanal username (@kanalim)
CHANNEL_ID=-1001234567890
# Sizning Telegram ID raqamingiz (faqat siz botdan foydalanasiz)
ADMIN_ID=123456789

# ===== Tavsif (sharh) yozish =====
# none   — tayyor shablon (bepul, har doim bir xil ko'rinish) — STANDART
# gemini — Google Gemini AI yozadi (bepul limiti bor, kalit kerak)
# claude — Claude AI yozadi (pullik)
AI_PROVIDER=none
# https://aistudio.google.com/apikey dan olingan kalit.
# Bo'sh qoldirsangiz ham bot ishlaydi — tavsif tayyor shablon bo'yicha yoziladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Faqat AI_PROVIDER=claude bo'lsa kerak (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ===== IXTIYORIY (o'zgartirmasangiz ham bo'ladi) =====
# Do'kon nomi
SHOP_NAME=Poyabzal Optom
# Bog'lanish uchun telefon yoki @username (kanal postining oxirida chiqadi)
CONTACT=
# Fonni olib tashlash modeli:
#   auto                   — kompyuter xotirasiga qarab o'zi tanlaydi (tavsiya)
#   birefnet-general       — eng sifatli, 16 GB xotira kerak, bir rasmga ~30-60 soniya
#   birefnet-general-lite  — sifatli, 12 GB xotira kerak, ~15-30 soniya
#   isnet-general-use      — oddiy, 4 GB xotira yetadi, ~2 soniya
BG_MODEL=auto
# Baza fayli joyi
DATABASE_PATH=data/shop.db
